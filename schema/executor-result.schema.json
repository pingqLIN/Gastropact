{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContracts executor result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "task_id",
    "contract_hash",
    "state_revision_seen",
    "action_id",
    "executor",
    "outcome",
    "summary",
    "changed_paths",
    "evidence",
    "verification",
    "workspace_baseline_digest",
    "lease_nonce"
  ],
  "properties": {
    "schema_version": {"const": "taskcontracts-executor-result.v2"},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "task_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_baseline_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lease_nonce": {"type": "string", "minLength": 1},
    "state_revision_seen": {"type": "integer", "minimum": 0},
    "action_id": {"type": "string", "minLength": 1},
    "executor": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["PASS", "BLOCKED", "FAILED", "RETRYABLE"]},
    "summary": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_class", "task_id", "contract_hash", "state_revision_seen", "action_id", "verified_action", "verifier", "timestamp", "verification_basis"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "state_revision_seen": {"type": "integer", "minimum": 0},
          "action_id": {"type": "string", "minLength": 1},
          "verified_action": {"type": "string", "minLength": 1},
          "verifier": {"const": "taskcontracts-local-sha256-v1"},
          "timestamp": {"type": "string", "format": "date-time"},
          "verification_basis": {"const": "artifact"},
          "artifact_path": {"type": "string", "minLength": 1},
          "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_size": {"type": "integer", "minimum": 0},
          "runtime_metadata": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"verification_basis": {"const": "artifact"}}, "required": ["verification_basis"]},
            "then": {"required": ["artifact_path", "artifact_digest", "artifact_size"]}
          }
        ]
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["PASS", "FAILED", "NOT_RUN"]},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "status", "summary", "evidence_ids"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["PASS", "FAILED", "NOT_RUN"]},
              "summary": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "blocker_code": {"type": ["string", "null"]},
    "blocker_detail": {"type": ["string", "null"]},
    "recommended_next_action": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "evidence": {"type": "array", "minItems": 1},
          "verification": {
            "type": "object",
            "properties": {"status": {"const": "PASS"}, "checks": {"type": "array", "minItems": 1}}
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "BLOCKED"}}, "required": ["outcome"]},
      "then": {
        "required": ["blocker_code"],
        "properties": {"blocker_code": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
